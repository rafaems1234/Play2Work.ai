# Copie para app/.env e preencha. O .env é ignorado pelo git -- segredos nunca vão pro GitHub.

# Ambiente. Vazio = PRODUÇÃO (seguro por padrão): CORS sem localhost e cookie do painel só em HTTPS.
# Em desenvolvimento na sua máquina: APP_ENV=local (ou DEBUG=true).
APP_ENV=

DATABASE_URL=postgresql://usuario:senha@localhost:5432/nome_do_banco

# Chave grátis em https://aistudio.google.com/apikey (sem ela, o app usa respostas de fallback)
GEMINI_API_KEY=
# Opcional: modelo do Gemini (padrão: gemini-3.5-flash-lite)
GEMINI_MODEL=

# Obrigatória. Gere com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Senha de INSTALAÇÃO do painel: só serve pra criar o primeiro Administrador da primeira escola.
ADMIN_SENHA=

# Endereço(s) do front publicado, separados por vírgula (o navegador só deixa o front falar com a API se estiver aqui).
# Ex.: CORS_ORIGINS=https://first2work.com.br
# localhost só é aceito com APP_ENV=local -- em produção é ignorado mesmo que esteja aqui.
CORS_ORIGINS=

# Sessão do painel: cookie httpOnly. O front e a API precisam ser do MESMO site
# (first2work.com.br + api.first2work.com.br), senão o navegador não manda o cookie.
# lax (padrão) ou strict.
COOKIE_SAMESITE=
# Vazio (recomendado) = o cookie vale só pro endereço da API.
COOKIE_DOMINIO=

# Limite de tentativas por IP compartilhado entre instâncias da API. Vazio = memória (um servidor só).
# O docker-compose.yml já aponta pro Redis dele. Ex.: redis://localhost:6379/0
REDIS_URL=

# Fotos dos alunos e materiais das aulas (fora do banco):
#   disco (padrão): pasta ARMAZENAMENTO_DIR (no Docker: /srv/arquivos, volume 'arquivos'). Bom pro piloto.
#   azure: Azure Blob Storage, contêiner PRIVADO. Pra várias instâncias e escala.
# Depois de atualizar um banco antigo: python arquivos.py migrar (move as fotos que estavam no banco).
ARMAZENAMENTO=
ARMAZENAMENTO_DIR=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=

# Opcional: validade do login do aluno, em horas (padrão: 4). Curto de propósito
# por causa dos computadores compartilhados dos laboratórios.
JWT_EXPIRA_HORAS_ALUNO=

# Teto de gasto da IA no mês, em dólares, somando todas as escolas (ver uso_ia.py).
# Vazio = sem teto (só pra desenvolvimento). Com teto, os DOIS preços abaixo são obrigatórios:
# sem preço o sistema não sabe quanto já gastou e desliga a IA por segurança.
# Preços do gemini-3.5-flash-lite, plano pago Standard, conferidos em 01/11/2026 em https://ai.google.dev/gemini-api/docs/pricing.
# Trocou o GEMINI_MODEL ou o Google mudou o preço? Atualize os dois.
GEMINI_TETO_MENSAL_USD=50
GEMINI_PRECO_ENTRADA_USD_POR_MILHAO=0.30
GEMINI_PRECO_SAIDA_USD_POR_MILHAO=2.50

# Produção: as migrações rodam com o DONO do banco e a API com um usuário que só lê/grava dados
# (docs/deploy/banco_usuarios.sql). Vazio = migrações usam a DATABASE_URL (desenvolvimento).
MIGRACAO_DATABASE_URL=

# Documentação interativa da API em /docs. Deixe vazio (fechada) em produção: ela mostra todas as rotas.
DOCS_ABERTAS=

# Verificação em duas etapas obrigatória pras contas do painel (padrão: true). false só em desenvolvimento.
GESTAO_2FA_OBRIGATORIA=
