# Copie para app/.env e preencha. O .env é ignorado pelo git -- segredos nunca vão pro GitHub.

DATABASE_URL=postgresql://usuario:senha@localhost:5432/nome_do_banco

# Chave grátis em https://aistudio.google.com/apikey (sem ela, o app usa respostas de fallback)
GEMINI_API_KEY=
# Opcional: modelo do Gemini (padrão: gemini-3.5-flash-lite)
GEMINI_MODEL=

# Obrigatória. Gere com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Senha de INSTALAÇÃO do painel: só serve pra criar o primeiro Administrador da primeira escola.
ADMIN_SENHA=

# Endereço(s) do front publicado, separados por vírgula (o navegador só deixa o front falar com a API se estiver aqui).
# Ex.: CORS_ORIGINS=https://rafaems1234.github.io
CORS_ORIGINS=

# Opcional: validade do login do aluno, em horas (padrão: 4). Curto de propósito
# por causa dos computadores compartilhados dos laboratórios.
JWT_EXPIRA_HORAS_ALUNO=

# Teto de gasto da IA no mês, em dólares, somando todas as escolas (ver uso_ia.py).
# Vazio = sem teto (só pra desenvolvimento). Com teto, os DOIS preços abaixo são obrigatórios:
# sem preço o sistema não sabe quanto já gastou e desliga a IA por segurança.
# Preços do gemini-3.5-flash-lite, plano pago Standard, conferidos em 01/11/2026 em https://ai.google.dev/gemini-api/docs/pricing.
# Trocou o GEMINI_MODEL ou o Google mudou o preço? Atualize os dois.
GEMINI_TETO_MENSAL_USD=50
GEMINI_PRECO_ENTRADA_USD_POR_MILHAO=0.30
GEMINI_PRECO_SAIDA_USD_POR_MILHAO=2.50
